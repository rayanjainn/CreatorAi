// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`buildFfmpegArgs snapshots > 1 clip, final 1`] = `
{
  "args": [
    "-ss",
    "1.000",
    "-t",
    "2.000",
    "-i",
    "https://cdn.test/a.mp4",
    "-filter_complex",
    "[0:v]trim=duration=2.000,setpts=PTS-STARTPTS,scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920,setsar=1,fps=30,format=yuv420p[v0];[0:a]atrim=duration=2.000,asetpts=PTS-STARTPTS,volume=1,aresample=48000,aformat=sample_fmts=fltp:sample_rates=48000:channel_layouts=stereo[a0];[v0][a0]concat=n=1:v=1:a=1[vout][aout]",
    "-map",
    "[vout]",
    "-map",
    "[aout]",
    "-c:v",
    "libx264",
    "-preset",
    "medium",
    "-crf",
    "20",
    "-pix_fmt",
    "yuv420p",
    "-c:a",
    "aac",
    "-b:a",
    "160k",
    "-ar",
    "48000",
    "-r",
    "30",
    "-movflags",
    "+faststart",
    "out.mp4",
  ],
  "durationMs": 2000,
  "height": 1920,
  "width": 1080,
}
`;

