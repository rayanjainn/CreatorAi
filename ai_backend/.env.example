# Copy to .env and fill in. Never commit .env.

# --- Postgres on localhost:5432 (no Docker). Tests only ever use DATABASE_URL_TEST. ---
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/aivideo
DATABASE_URL_TEST=postgres://postgres:YOUR_PASSWORD@localhost:5432/aivideo_test

# --- Auth: any long random string ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Switches ---
# real = call providers; fake = deterministic fakes (tests always force fake)
ADAPTERS=real
# pgvector if the extension is installed (preflight tells you), otherwise array.
# Switching later needs fresh databases (drop aivideo and aivideo_test, then npm run preflight):
# vector columns are created with the backend's type.
VECTOR_BACKEND=pgvector
EMBED_DIM=768

# --- Models (IDs live here, never in code: free-tier model lists change) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
VISION_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
STT_MODEL=whisper-large-v3-turbo
EMBED_MODEL=gemini-embedding-2

# --- Provider keys (required when ADAPTERS=real) ---
GEMINI_API_KEY=
GROQ_API_KEY=
# tavily or serper; set the matching key
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional: FFmpeg binaries if they are not on PATH ---
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe
