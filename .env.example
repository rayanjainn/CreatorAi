# CreatorAi configuration. Copy to .env (`make setup` does this).
# The app runs the REAL AI pipeline: set at least one LLM key below (all have free tiers).
# With none set, AI endpoints return LLM_NOT_CONFIGURED (503) until you add one.

# --- Runtime ------------------------------------------------------------------------------
APP_ENV=dev                     # dev | test | prod
LOG_LEVEL=INFO
DATA_DIR=./data                 # database, media, renders and tmp live here (relative to the repo root)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# --- Auth ---------------------------------------------------------------------------------
AUTH_MODE=local                 # local email + password (only mode in local-first)
AUTH_ALLOW_MULTI=false          # true lets more than one account sign up
JWT_TTL_DAYS=7
APP_SECRET=                     # blank = generated once and saved to data/.secret
MEDIA_SIGNING_SECRET=           # blank = derived from APP_SECRET
MEDIA_URL_TTL_SEC=3600

# --- LumiClip cloud clipper (optional) -----------------------------------------------------
# Clips a public video link (YouTube etc.) in the cloud. Keys stay on the server, never in the browser.
# Without a key the Smart Clips page still works with your own footage (the local AI clipper).
# Web search for the Research agent (optional, free tiers): tavily or serper
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=
LUMICLIP_API_KEY=
LUMICLIP_BASE_URL=https://api.lumiclip.ai
# Tests against scripts/fake_lumiclip.py only: allow downloading clips from 127.0.0.1
LUMICLIP_ALLOW_PRIVATE_DOWNLOADS=false
# Only needed to send a LIBRARY video to LumiClip (it needs a public URL, so the file is uploaded to
# your Cloudinary account first). Pasting a public video URL needs none of these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- YouTube (optional; without it insights use seeded demo data) -------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/youtube/oauth/callback

# --- LLM (real providers: Gemini, Groq, Ollama; no OpenAI / Anthropic) ---------------------
# Get free keys: Google AI Studio https://aistudio.google.com/apikey
#                Groq console      https://console.groq.com/keys
#                Ollama Cloud      https://ollama.com/settings/keys
# Verify them with POST /api/v1/llm/test (or the Settings page). Model ids are user-adjustable;
# copy current ids from each console, free-tier model lists change.
GEMINI_API_KEY=
GEMINI_MODEL_MAIN=gemini-2.5-flash
GEMINI_MODEL_LITE=gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
OLLAMA_API_KEY=                 # Ollama Cloud key; leave blank for a local server
OLLAMA_BASE_URL=https://ollama.com   # local Ollama: http://localhost:11434 (no key needed)
OLLAMA_MODEL=gpt-oss:120b       # any model your Ollama account/server can run
OLLAMA_VISION_MODEL=qwen3-vl:235b    # used for image tasks; blank disables Ollama for vision
LLM_PROVIDER_ORDER=gemini,groq,ollama   # who is tried first; unconfigured providers are skipped
# Mock is a dev/test opt-in ONLY. When true, a deterministic fake provider is the last link of the
# chain; its output is marked "[MOCK]" and provenance.source="mock". Never enable for real use.
LLM_ALLOW_MOCK=false
LLM_CACHE_ENABLED=true
LLM_TIMEOUT_SEC=30
LLM_QUEUE_WAIT_SEC=25           # max wait for a rate-limit slot before LLM_BUSY
GEMINI_RPM=8                    # in-process rate limits, conservative under the free tier
GROQ_RPM=20
OLLAMA_RPM=30
GROQ_TPM=6000
GROQ_MAX_INPUT_TOKENS=6000      # skip Groq when the prompt estimate exceeds this
LLM_BACKOFF_BASE_SEC=1          # HTTP 429/5xx backoff: 1s, 2s, 4s (max 3 tries)
LLM_CIRCUIT_FAILURES=3          # consecutive failures that open a provider circuit
LLM_CIRCUIT_OPEN_SEC=60

# --- Transcription (chain: sidecar transcript -> Groq Whisper -> local faster-whisper) ----------
ASR_PROVIDER=auto               # auto | groq | faster-whisper | none
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
WHISPER_LOCAL_MODEL=small
ASR_CHUNK_SEC=600
ASR_LANGUAGE=auto

# --- Embeddings ---------------------------------------------------------------------------
# auto = fastembed (ONNX MiniLM, real) -> sentence-transformers (if installed) -> hashing.
# hashing is a flagged heuristic fallback only. Run `make models` once while online.
EMBED_BACKEND=auto              # auto | fastembed | sentence-transformers | hashing
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Match thresholds are per backend. Tune on the hero footage.
MATCH_OK_ST=0.45
MATCH_WEAK_ST=0.30
MATCH_OK_HASHING=0.30
MATCH_WEAK_HASHING=0.15

# --- Uploads and ingest -------------------------------------------------------------------
MAX_UPLOAD_BYTES=8589934592     # 8 GB per file
UPLOAD_CHUNK_SIZE=8388608       # chunk size handed to resumable uploads (8 MB)
MIN_FREE_DISK_MB=200            # uploads are refused unless 2x the file size + this is free
UPLOAD_STALE_HOURS=24           # unfinished uploads older than this are purged nightly
KEYFRAME_EXTRACT_MAX=48         # keyframes extracted per video (<= KEYFRAME_MAX_SHOTS are captioned)
ASR_MAX_TRIES=3                 # attempts per chunk and provider before falling back

# --- Jobs ---------------------------------------------------------------------------------
JOBS_INLINE=false               # true runs jobs synchronously (tests)
JOB_MAX_RETRIES=2
JOB_RETRY_BACKOFF=10,30         # seconds before retry 1, retry 2
JOB_POOL_MEDIA=1
JOB_POOL_LLM=2
JOB_POOL_IO=1

# --- Media analysis, clips and rendering (Plan.md section 8) ------------------------------
CLIP_MIN_SEC=20
CLIP_MAX_SEC=45
CLIP_TOP_K=8
CLIP_KEEP=4
SILENCE_MIN_SEC=0.6
SILENCE_NOISE_DB=-35
PAUSE_KEEP_SEC=0.15
SHOT_THRESHOLD=27
SHOT_MIN_LEN_FRAMES=15
KEYFRAME_MAX_SHOTS=12
RENDER_X264_PRESET=veryfast
# Caption burn-in on export: auto = libass when this ffmpeg has a working `subtitles` filter, else the
# built-in Pillow renderer (works on any ffmpeg, e.g. Homebrew's); or force libass | pillow
CAPTION_RENDERER=auto
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
